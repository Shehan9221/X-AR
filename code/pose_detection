# --- Landmark indices (MediaPipe Face Mesh, refine_landmarks=True) ---
LEFT_IRIS_CENTER = 468    # subject's left eye (mirrored image = viewer's right)
RIGHT_IRIS_CENTER = 473   # subject's right eye
 
# Points that sit on the facial midline, top to bottom.
# 10: forehead/hairline, 168: nasion, 4: nose tip, 164: philtrum,
# 0: upper lip center, 17: lower lip/mentolabial fold, 152: chin (menton)
MIDLINE_LANDMARKS = [10, 168, 4, 164, 0, 17, 152]

 
def _to_px(landmark, w, h):
    return np.array([landmark.x * w, landmark.y * h])
 
 
def compute_interpupillary_line(face_landmarks, image_width, image_height):
    """
    face_landmarks: the .landmark list from a MediaPipe FaceMesh result
    Returns dict with pupil points, midpoint, length, and tilt angle
    (angle_deg == 0 means perfectly horizontal / no head roll).
    """
    p_left = _to_px(face_landmarks[LEFT_IRIS_CENTER], image_width, image_height)
    p_right = _to_px(face_landmarks[RIGHT_IRIS_CENTER], image_width, image_height)
 
    delta = p_right - p_left
    angle_deg = np.degrees(np.arctan2(delta[1], delta[0]))  # tilt from horizontal
 
    return {
        "left_pupil": p_left,
        "right_pupil": p_right,
        "midpoint": (p_left + p_right) / 2,
        "length": float(np.linalg.norm(delta)),
        "angle_deg": float(angle_deg),   # + = right pupil lower, - = right pupil higher
    }

def compute_head_medial_sagittal_line(face_landmarks, image_width, image_height,
                                  midline_indices=MIDLINE_LANDMARKS):
    """
    Fits a line through several midline landmarks (PCA / total-least-squares)
    instead of just connecting two points, which makes it far less sensitive
    to a single noisy landmark.
 
    Returns dict with the fitted point set's centroid, unit direction vector,
    and tilt_from_vertical_deg (0 == perfectly vertical / no rotation).
    """
    pts = np.array([_to_px(face_landmarks[i], image_width, image_height)
                     for i in midline_indices])
 
    centroid = pts.mean(axis=0)
    centered = pts - centroid
 
    # Principal axis of the midline points = best-fit line direction
    _, _, vh = np.linalg.svd(centered)
    direction = vh[0]
    if direction[1] < 0:          # force direction to point "downward" (+y)
        direction = -direction
 
    angle_from_vertical = np.degrees(np.arctan2(direction[0], direction[1]))
 
    return {
        "points": pts,
        "centroid": centroid,
        "direction": direction,          # unit vector, points top->chin
        "tilt_from_vertical_deg": float(angle_from_vertical),
        "top_point": pts[0],
        "bottom_point": pts[-1],
    }
 


def resize_for_display(frame, max_width=960, max_height=1080):
    h, w = frame.shape[:2]
    scale = min(max_width / w, max_height / h, 1.0)  # never upscale, only shrink
    if scale < 1.0:
        frame = cv2.resize(frame, (int(w * scale), int(h * scale)))
    return frame

def get_scaled_line_params(frame_shape, base_thickness=2, base_font_scale=0.5, reference_width=960):
    """Scale line thickness and font size relative to frame resolution."""
    w = frame_shape[1]
    scale_factor = w / reference_width
    thickness = max(1, int(base_thickness * scale_factor))
    font_scale = base_font_scale * scale_factor
    return thickness, font_scale

def get_torso_reference(pose_landmarks, frame_shape):
    """Shared helper: returns hip_y, shoulder_y, torso_length_px, and center x-coords."""
    h, w = frame_shape[:2]
    left_shoulder = pose_landmarks[mp_pose.PoseLandmark.LEFT_SHOULDER]
    right_shoulder = pose_landmarks[mp_pose.PoseLandmark.RIGHT_SHOULDER]
    left_hip = pose_landmarks[mp_pose.PoseLandmark.LEFT_HIP]
    right_hip = pose_landmarks[mp_pose.PoseLandmark.RIGHT_HIP]

    shoulder_y = left_shoulder.y * h
    hip_y = left_hip.y * h
    torso_length_px = hip_y - shoulder_y

    center_x = ((left_hip.x + right_hip.x) / 2) * w
    shoulder_width_px = abs((right_shoulder.x - left_shoulder.x) * w)

    return hip_y, torso_length_px, center_x, shoulder_width_px

def draw_head_medial_sagittal_line(frame, face_landmarks, frame_shape):
    h, w = frame_shape[:2]
    msl = compute_head_medial_sagittal_line(face_landmarks, w, h)
    top_point = tuple(msl["top_point"].astype(int))
    bottom_point = tuple(msl["bottom_point"].astype(int))

    thickness, font_scale = get_scaled_line_params(frame_shape)

    cv2.line(frame, top_point, bottom_point, (0, 0, 255), thickness)
    cv2.putText(frame, "msl", (bottom_point[0] + 5, bottom_point[1] + 5), cv2.FONT_HERSHEY_SIMPLEX, font_scale, (0, 0, 255), max(1, thickness))
    return msl


def draw_landmark_line(frame, pose_landmarks, frame_shape, k, label, color, width_ratio=0.8):
    hip_y, torso_length_px, center_x, shoulder_width_px = get_torso_reference(pose_landmarks, frame_shape)
    line_y = int(hip_y - k * torso_length_px)
    half_width = int((width_ratio * shoulder_width_px) / 2)
    x1, x2 = int(center_x - half_width), int(center_x + half_width)

    thickness, font_scale = get_scaled_line_params(frame_shape)

    cv2.line(frame, (x1, line_y), (x2, line_y), color, thickness)
    cv2.putText(frame, label, (x2 + 5, line_y + 5), cv2.FONT_HERSHEY_SIMPLEX, font_scale, color, max(1, thickness ))
    return line_y

def draw_interpupillary_line(frame, face_landmarks, frame_shape):
    h, w = frame_shape[:2]
    ip_line = compute_interpupillary_line(face_landmarks, w, h)
    left_pupil = tuple(ip_line["left_pupil"].astype(int))
    right_pupil = tuple(ip_line["right_pupil"].astype(int))

    thickness, font_scale = get_scaled_line_params(frame_shape)

    cv2.line(frame, left_pupil, right_pupil, (0, 255, 255), thickness)
    cv2.putText(frame, "ipl", (right_pupil[0] + 5, right_pupil[1] + 5), cv2.FONT_HERSHEY_SIMPLEX, font_scale, (0, 255, 255), max(1, thickness))
    return ip_line

def draw_diaphragm_line(frame, pose_landmarks, frame_shape, k=0.55):
    return draw_landmark_line(frame, pose_landmarks, frame_shape, k, "Diaphragm", (255, 200, 0))


def draw_iliac_crest_line(frame, pose_landmarks, frame_shape, k=0.20):
    return draw_landmark_line(frame, pose_landmarks, frame_shape, k, "Iliac Crest", (0, 200, 255))


def draw_asis_line(frame, pose_landmarks, frame_shape, k=0.08):
    return draw_landmark_line(frame, pose_landmarks, frame_shape, k, "ASIS", (0, 255, 0))


def draw_mid_sagittal_line(frame,Rshoulder,Lshoulder,Rhip,Lhip ):

    def find_midpoint(point1, point2):
        return (int((point1[0] + point2[0]) / 2),int((point1[1] + point2[1]) / 2))
    
    def point_normalizer(pointcordinates):
        """Convert relative coordinates (x, y) to absolute pixel coordinates based on frame size. out put - tuples"""  
        height, width, _ = frame.shape
        return (int(pointcordinates.x * width), int(pointcordinates.y * height))
    
    def extend_line(p1, p2, extend_up=25, extend_down=100):
        """Extends a line segment between two points in both directions by specified distances."""

        p1 = np.array(p1, dtype=float)  # shoulder midpoint
        p2 = np.array(p2, dtype=float)  # hip midpoint

        direction = p2 - p1
        length = np.linalg.norm(direction)
        unit = direction / length

        new_top = p1 - unit * extend_up      # goes further upward
        new_bottom = p2 + unit * extend_down # goes further downward

        return tuple(new_top.astype(int)), tuple(new_bottom.astype(int))

    nor_Rshoulder = point_normalizer(Rshoulder)
    nor_Lshoulder = point_normalizer(Lshoulder)
    nor_Rhip = point_normalizer(Rhip)
    nor_Lhip = point_normalizer(Lhip)

    shoulder_midpoint = find_midpoint(nor_Rshoulder, nor_Lshoulder)
    hip_midpoint = find_midpoint(nor_Rhip, nor_Lhip)
    #cv2.line(frame, shoulder_midpoint, hip_midpoint, (0, 0, 255), 2)
    new_top, new_bottom = extend_line(shoulder_midpoint, hip_midpoint)
    cv2.line(frame, new_top, new_bottom, (0, 0, 255), 5)
    cv2.putText(frame, "msl", (new_bottom[0] + 5, new_bottom[1] + 5), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 255), 1)


