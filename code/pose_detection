def resize_for_display(frame, max_width=960, max_height=1080):
    h, w = frame.shape[:2]
    scale = min(max_width / w, max_height / h, 1.0)  # never upscale, only shrink
    if scale < 1.0:
        frame = cv2.resize(frame, (int(w * scale), int(h * scale)))
    return frame


def get_scaled_line_params(frame_shape, base_thickness=2, base_font_scale=0.5, reference_width=960):
    """Scale line thickness and font size relative to frame resolution."""
    w = frame_shape[1]
    scale_factor = w / reference_width
    thickness = max(1, int(base_thickness * scale_factor))
    font_scale = base_font_scale * scale_factor
    return thickness, font_scale



