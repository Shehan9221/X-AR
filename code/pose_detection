class TrunkPoseAssessment:
    """Owns MediaPipe PoseLandmarker setup and runs body-landmark detection per frame."""

    def __init__(self, model_asset_path='pose_landmarker_full.task'):
        self.mp_pose = mp.solutions.pose
        # MediaPipe has a long-standing bug on Windows where model_asset_path
        # gets unconditionally concatenated with the venv's site-packages
        # folder, breaking both relative and absolute paths
        # (see: github.com/google-ai-edge/mediapipe/issues/5343).
        # Reading the model file ourselves and passing the raw bytes via
        # model_asset_buffer instead of model_asset_path sidesteps that
        # broken path-resolution logic entirely.
        with open(model_asset_path, 'rb') as f:
            model_bytes = f.read()
        base_options = python.BaseOptions(model_asset_buffer=model_bytes)
        options = vision.PoseLandmarkerOptions(
            base_options=base_options,
            running_mode=vision.RunningMode.VIDEO
        )
        self.detector = vision.PoseLandmarker.create_from_options(options)

    def detect(self, mp_image, frame_timestamp):
        """Runs PoseLandmarker on an mp.Image. Returns the raw result object."""
        return self.detector.detect_for_video(mp_image, frame_timestamp)

    def get_pose_landmarks(self, mp_image, frame_timestamp):
        """Convenience: returns (first_person_landmarks_or_None, raw_result)."""
        result = self.detect(mp_image, frame_timestamp)
        if result.pose_landmarks:
            return result.pose_landmarks[0], result
        return None, result


class TrunkAnatomicalLine:
    """Computes and draws anatomical reference lines on the trunk/torso."""

    def get_torso_geometry(self, pose_landmarks, frame_shape):
        """Returns every torso reference value in pixels.

        Keeping the full geometry in one place lets callers that only need a
        subset (the line-drawing helpers below, or the GUI overlay) reuse the
        exact same reference instead of recomputing midpoints.
        """
        h, w = frame_shape[:2]
        mp_pose = solutions.pose
        left_shoulder = pose_landmarks[mp_pose.PoseLandmark.LEFT_SHOULDER]
        right_shoulder = pose_landmarks[mp_pose.PoseLandmark.RIGHT_SHOULDER]
        left_hip = pose_landmarks[mp_pose.PoseLandmark.LEFT_HIP]
        right_hip = pose_landmarks[mp_pose.PoseLandmark.RIGHT_HIP]

        hip_center = (((left_hip.x + right_hip.x)*w / 2), ((left_hip.y + right_hip.y)*h / 2))
        shoulder_center = (((left_shoulder.x + right_shoulder.x)*w / 2),(((left_shoulder.y + right_shoulder.y) *h/ 2)))
        torso_length_px = np.sqrt((shoulder_center[0] - hip_center[0]) ** 2 + (shoulder_center[1] - hip_center[1]) ** 2)
        hip_center_x = hip_center[0]
        shoulder_width_px = np.sqrt(((left_shoulder.x - right_shoulder.x)*w) ** 2 + ((left_shoulder.y - right_shoulder.y)* h) ** 2)

        return {
            "hip_center": hip_center,
            "shoulder_center": shoulder_center,
            "torso_length_px": torso_length_px,
            "hip_center_x": hip_center_x,
            "shoulder_width_px": shoulder_width_px,
        }

    def get_torso_reference(self, pose_landmarks, frame_shape):
        """Shared helper: returns hip_y, torso_length_px, center_x, and shoulder_width_px."""
        geo = self.get_torso_geometry(pose_landmarks, frame_shape)
        return (geo["hip_center"], geo["torso_length_px"],
                geo["hip_center_x"], geo["shoulder_width_px"])

    def draw_landmark_line(self, frame, pose_landmarks, frame_shape, k, label, color, width_ratio=0.8):
        hip_center, torso_length_px, hip_center_x, shoulder_width_px = self.get_torso_reference(pose_landmarks, frame_shape)
        line_y = int(hip_center[1] - k * torso_length_px)
        half_width = int((width_ratio * shoulder_width_px) / 2)
        x1, x2 = int(hip_center_x - half_width), int(hip_center_x + half_width)

        thickness, font_scale = get_scaled_line_params(frame_shape)

        cv2.line(frame, (x1, line_y), (x2, line_y), color, thickness)
        cv2.putText(frame, label, (x2 + 5, line_y + 5), cv2.FONT_HERSHEY_SIMPLEX, font_scale, color, max(1, thickness))
        return line_y

    def draw_diaphragm_line(self, frame, pose_landmarks, frame_shape, k=0.55):
        return self.draw_landmark_line(frame, pose_landmarks, frame_shape, k, "Diaphragm", (255, 200, 0))

    def draw_iliac_crest_line(self, frame, pose_landmarks, frame_shape, k=0.20):
        return self.draw_landmark_line(frame, pose_landmarks, frame_shape, k, "Iliac Crest", (0, 200, 255))

    def draw_asis_line(self, frame, pose_landmarks, frame_shape, k=0.1):
        return self.draw_landmark_line(frame, pose_landmarks, frame_shape, k, "ASIS", (0, 255, 0))

    def draw_mid_sagittal_line(self, frame, Rshoulder, Lshoulder, Rhip, Lhip):

        def find_midpoint(point1, point2):
            return (int((point1[0] + point2[0]) / 2), int((point1[1] + point2[1]) / 2))

        def point_normalizer(pointcordinates):
            """Convert relative coordinates (x, y) to absolute pixel coordinates based on frame size."""
            height, width, _ = frame.shape
            return (int(pointcordinates.x * width), int(pointcordinates.y * height))

        def extend_line(p1, p2, extend_up=25, extend_down=100):
            """Extends a line segment between two points in both directions by specified distances."""
            p1 = np.array(p1, dtype=float)  # shoulder midpoint
            p2 = np.array(p2, dtype=float)  # hip midpoint

            direction = p2 - p1
            length = np.linalg.norm(direction)
            unit = direction / length

            new_top = p1 - unit * extend_up      # goes further upward
            new_bottom = p2 + unit * extend_down  # goes further downward

            return tuple(new_top.astype(int)), tuple(new_bottom.astype(int))

        nor_Rshoulder = point_normalizer(Rshoulder)
        nor_Lshoulder = point_normalizer(Lshoulder)
        nor_Rhip = point_normalizer(Rhip)
        nor_Lhip = point_normalizer(Lhip)

        shoulder_midpoint = find_midpoint(nor_Rshoulder, nor_Lshoulder)
        hip_midpoint = find_midpoint(nor_Rhip, nor_Lhip)
        new_top, new_bottom = extend_line(shoulder_midpoint, hip_midpoint)
        cv2.line(frame, new_top, new_bottom, (0, 0, 255), 5)
        cv2.putText(frame, "msl", (new_bottom[0] + 5, new_bottom[1] + 5),
        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 255), 1)


class TrunkPositioningTracker:
    """Computes trunk positioning metrics and draws coloured overlay panels."""
    L_SHO, R_SHO, L_HIP, R_HIP = 11, 12, 23, 24

    GREEN = (0, 200, 0)
    YELLOW = (0, 200, 255)
    RED = (0, 0, 255)
    WHITE = (255, 255, 255)

    def __init__(self, rotation_tol_deg=5.0, level_tol_deg=3.0,
                 min_visibility=0.5, smoothing=0.8):
        self.rotation_tol = rotation_tol_deg
        self.level_tol = level_tol_deg
        self.min_vis = min_visibility
        self.smoothing = smoothing
        self.baseline = None
        self._smoothed = {}

    # ---------- helpers ----------
    @staticmethod
    def _dist(a, b, w, h):
        return math.hypot((a.x - b.x) * w, (a.y - b.y) * h)

    @staticmethod
    def _yaw_deg(world, left_i, right_i):
        """Signed yaw in the x-z plane. 0 = square to camera,
        + = person's left side pushed away from camera."""
        dx = world[left_i].x - world[right_i].x
        dz = world[left_i].z - world[right_i].z
        return math.degrees(math.atan2(dz, dx))

    @staticmethod
    def _tilt_deg(left, right, w, h):
        """Angle of the right->left line vs the image horizontal.
        0 = level, + = person's left side lower."""
        dx = (left.x - right.x) * w
        dy = (left.y - right.y) * h
        return math.degrees(math.atan2(dy, dx))

    def _smooth(self, key, value):
        if key not in self._smoothed:
            self._smoothed[key] = value
        else:
            a = self.smoothing
            self._smoothed[key] = a * self._smoothed[key] + (1 - a) * value
        return self._smoothed[key]

    def _get_landmarks(self, result):
        if not result or not result.pose_landmarks or not result.pose_world_landmarks:
            return None, None
        img = result.pose_landmarks[0]
        world = result.pose_world_landmarks[0]
        idx = (self.L_SHO, self.R_SHO, self.L_HIP, self.R_HIP)
        if min(img[i].visibility for i in idx) < self.min_vis:
            return None, None
        return img, world

    def _grade(self, value, tol):
        """Returns (grade_str, abs_value). OK / BORDERLINE / FAIL."""
        av = abs(value)
        if av <= tol:
            return "OK", av
        elif av <= tol * 2:
            return "BORDERLINE", av
        else:
            return "FAIL", av

    def _color_for(self, value, tol):
        """Green / yellow / red depending on how far *value* is from tolerance."""
        grade, _ = self._grade(value, tol)
        if grade == "OK":
            return self.GREEN
        elif grade == "BORDERLINE":
            return self.YELLOW
        return self.RED

    # ---------- measurements ----------
    def compute_rotation(self, img, world, w, h):
        out = {}
        out["shoulder_yaw"] = self._yaw_deg(world, self.L_SHO, self.R_SHO)
        out["hip_yaw"] = self._yaw_deg(world, self.L_HIP, self.R_HIP)
        out["twist"] = out["shoulder_yaw"] - out["hip_yaw"]

        sho_mid = ((img[self.L_SHO].x + img[self.R_SHO].x) / 2,
                   (img[self.L_SHO].y + img[self.R_SHO].y) / 2)
        hip_mid = ((img[self.L_HIP].x + img[self.R_HIP].x) / 2,
                   (img[self.L_HIP].y + img[self.R_HIP].y) / 2)
        torso = math.hypot((sho_mid[0] - hip_mid[0]) * w,
                           (sho_mid[1] - hip_mid[1]) * h)

        out["sho_ratio"] = self._dist(img[self.L_SHO], img[self.R_SHO], w, h) / torso
        out["hip_ratio"] = self._dist(img[self.L_HIP], img[self.R_HIP], w, h) / torso

        if self.baseline:
            c = min(1.0, out["sho_ratio"] / self.baseline["sho_ratio"])
            out["shoulder_angle_2d"] = math.degrees(math.acos(c))
        return out

    def assess_level(self, img, w, h):
        """Are the shoulders level? Are the hips level?"""
        sho_tilt = self._tilt_deg(img[self.L_SHO], img[self.R_SHO], w, h)
        hip_tilt = self._tilt_deg(img[self.L_HIP], img[self.R_HIP], w, h)
        return {
            "shoulder_tilt": sho_tilt,
            "hip_tilt": hip_tilt,
            "tilt_diff": sho_tilt - hip_tilt,
            "shoulders_level": abs(sho_tilt) <= self.level_tol,
            "hips_level": abs(hip_tilt) <= self.level_tol,
        }

    # ---------- main entry points ----------
    def calibrate(self, result, w, h):
        """Call while the person stands square to the camera."""
        img, world = self._get_landmarks(result)
        if img is None:
            return False
        r = self.compute_rotation(img, world, w, h)
        self.baseline = {"sho_ratio": r["sho_ratio"], "hip_ratio": r["hip_ratio"]}
        return True

    def update(self, result, w, h):
        img, world = self._get_landmarks(result)
        if img is None:
            return None

        m = {}
        m.update(self.compute_rotation(img, world, w, h))
        m.update(self.assess_level(img, w, h))

        for k, v in list(m.items()):
            if isinstance(v, float):
                m[k] = self._smooth(k, v)

        m["rotation_ok"] = abs(m["shoulder_yaw"]) <= self.rotation_tol
        m["shoulders_level"] = abs(m["shoulder_tilt"]) <= self.level_tol
        m["hips_level"] = abs(m["hip_tilt"]) <= self.level_tol
        m["all_ok"] = m["rotation_ok"] and m["shoulders_level"] and m["hips_level"]

        m["pts"] = {
            i: (int(img[i].x * w), int(img[i].y * h))
            for i in (self.L_SHO, self.R_SHO, self.L_HIP, self.R_HIP)
        }
        return m

    # ---------- overlay drawing ----------
    def _draw_rows(self, frame, rows, origin, width=420):
        """Draw a black panel with coloured text rows at origin=(x, y)."""
        x0, y0 = origin
        cv2.rectangle(frame, (x0, y0), (x0 + width, y0 + 12 + 28 * len(rows)), (0, 0, 0), -1)
        y = y0 + 28
        for text, color in rows:
            cv2.putText(frame, text, (x0 + 10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.6, color, 2)
            y += 28

    def _row(self, name, value, tol, neg_text, pos_text):
        grade, _ = self._grade(value, tol)
        color = self._color_for(value, tol)
        if grade == "OK":
            return f"{name}: OK", color
        side = pos_text if value > 0 else neg_text
        return f"{name}: {grade} - {side} ({abs(value):.1f} deg)", color

    def show_level(self, frame, m):
        """Shoulder line and hip line, coloured by how far from level they are."""
        if m is None:
            return frame
        p = m["pts"]
        sho_col = self._color_for(m["shoulder_tilt"], self.level_tol)
        hip_col = self._color_for(m["hip_tilt"], self.level_tol)
        cv2.line(frame, p[self.L_SHO], p[self.R_SHO], sho_col, 3)
        cv2.line(frame, p[self.L_HIP], p[self.R_HIP], hip_col, 3)

        rows = [
            self._row("Shoulders level", m["shoulder_tilt"], self.level_tol,
                      "right shoulder lower", "left shoulder lower"),
            self._row("Hips level", m["hip_tilt"], self.level_tol,
                      "right hip lower", "left hip lower"),
        ]
        self._draw_rows(frame, rows, origin=(0, 0))
        return frame

    def show_rotation(self, frame, m):
        """Shoulder and hip joints, coloured by how far the trunk is rotated."""
        if m is None:
            return frame
        p = m["pts"]
        sho_col = self._color_for(m["shoulder_yaw"], self.rotation_tol)
        hip_col = self._color_for(m["hip_yaw"], self.rotation_tol)
        for i in (self.L_SHO, self.R_SHO):
            cv2.circle(frame, p[i], 9, sho_col, -1)
        for i in (self.L_HIP, self.R_HIP):
            cv2.circle(frame, p[i], 9, hip_col, -1)

        rows = [
            self._row("Shoulder rotation", m["shoulder_yaw"], self.rotation_tol,
                      "right shoulder back", "left shoulder back"),
            self._row("Hip rotation", m["hip_yaw"], self.rotation_tol,
                      "right hip back", "left hip back"),
        ]
        self._draw_rows(frame, rows, origin=(0, 80))
        return frame

    def draw_results(self, frame, m):
        """Combined text overlay with all metrics."""
        if m is None:
            cv2.putText(frame, "Trunk not visible", (10, 30),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, self.RED, 2)
            return frame

        p = m["pts"]
        sho_col = self.GREEN if m["shoulders_level"] else self.RED
        hip_col = self.GREEN if m["hips_level"] else self.RED
        cv2.line(frame, p[self.L_SHO], p[self.R_SHO], sho_col, 3)
        cv2.line(frame, p[self.L_HIP], p[self.R_HIP], hip_col, 3)

        lines = [
            (f"Rotation: {m['shoulder_yaw']:+.1f} deg", m["rotation_ok"]),
            (f"Twist (sho-hip): {m['twist']:+.1f} deg", abs(m["twist"]) <= self.rotation_tol),
            (f"Shoulder tilt: {m['shoulder_tilt']:+.1f} deg", m["shoulders_level"]),
            (f"Hip tilt: {m['hip_tilt']:+.1f} deg", m["hips_level"]),
        ]
        if "shoulder_angle_2d" in m:
            lines.append((f"2D rotation check: {m['shoulder_angle_2d']:.1f} deg", True))

        y = 30
        for text, ok in lines:
            cv2.putText(frame, text, (10, y), cv2.FONT_HERSHEY_SIMPLEX,
                        0.6, self.GREEN if ok else self.RED, 2)
            y += 26

        verdict = "POSITION OK" if m["all_ok"] else "ADJUST POSITION"
        cv2.putText(frame, verdict, (10, y + 10), cv2.FONT_HERSHEY_SIMPLEX,
                    0.9, self.GREEN if m["all_ok"] else self.RED, 3)
        return frame

    def print_results(self, m):
        if m is None:
            print("Trunk not visible")
            return
        print(f"rotation={m['shoulder_yaw']:+.1f}  twist={m['twist']:+.1f}  "
              f"sho_tilt={m['shoulder_tilt']:+.1f}  hip_tilt={m['hip_tilt']:+.1f}  "
              f"-> {'OK' if m['all_ok'] else 'ADJUST'}")



