class VideoLoop:
    """
    Owns the camera/video capture and drives the frame-by-frame processing.
    process_frame() is UI-agnostic (no imshow/waitKey inside it), so it can later
    be called from a QTimer/QThread in a PyQt GUI instead of run()'s while-loop.
    """

    def __init__(self, video_source=0, model_asset_path='pose_landmarker_full.task'):
        self.cap = cv2.VideoCapture(video_source)
        self.frame_timestamp = 0

        self.head_pose_assessment = HeadPoseAssessment()
        self.head_anatomical_line = HeadAnatomicalLine()
        self.head_possitioning_tracker = HeadPossitioningTracker()

        self.trunk_pose_assessment = TrunkPoseAssessment(model_asset_path=model_asset_path)
        self.trunk_anatomical_line = TrunkAnatomicalLine()
        self.trunk_positioning_tracker = TrunkPositioningTracker()
        self.switches = Switches()

    def process_frame(self, frame):
        """Runs detection + draws all anatomical lines on a single frame. Returns the annotated frame."""
        rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb_frame)
        # --- Head ---
        sw = self.switches

        
        face_landmarks_list = self.head_pose_assessment.get_face_landmarks_list(rgb_frame)
        for face_landmarks in face_landmarks_list:
            if sw["head_msl"]:
                self.head_anatomical_line.draw_head_medial_sagittal_line(frame, face_landmarks, frame.shape)
            if sw["ipl"]:
                self.head_anatomical_line.draw_interpupillary_line(frame, face_landmarks, frame.shape)
            if sw["head_tilt"]:
                self.head_possitioning_tracker.show_head_tilt_assessment(frame,face_landmarks,mirrored=True)
            if sw["head_rotation"]:
                msl = self.head_anatomical_line.compute_head_medial_sagittal_line(face_landmarks, frame.shape[1], frame.shape[0])
                self.head_possitioning_tracker.show_head_rotation(frame, face_landmarks, msl, mirrored=True)

        # --- Trunk ---
        
        pose_landmarks, result = self.trunk_pose_assessment.get_pose_landmarks(mp_image, self.frame_timestamp)
        self.frame_timestamp += 33  # ~30fps

        if sw.any_on("trunk_skeleton","head_mesh"):
            if result.pose_landmarks:
                for pl in result.pose_landmarks:
                    proto = landmark_pb2.NormalizedLandmarkList()
                    proto.landmark.extend([
                        landmark_pb2.NormalizedLandmark(x=lm.x, y=lm.y, z=lm.z)
                        for lm in pl
                    ])
                solutions.drawing_utils.draw_landmarks(
                    frame,
                    proto,
                    solutions.pose.POSE_CONNECTIONS,
                    landmark_drawing_spec=solutions.drawing_utils.DrawingSpec(
                        color=(0, 255, 0), thickness=4, circle_radius=5
                    ),
                    connection_drawing_spec=solutions.drawing_utils.DrawingSpec(
                        color=(255, 255, 255), thickness=4
                    )
                )

        
        if pose_landmarks is not None:
            Rshoulder = pose_landmarks[11]  # Right shoulder
            Lshoulder = pose_landmarks[12]  # Left shoulder
            Rhip = pose_landmarks[23]       # Right hip
            Lhip = pose_landmarks[24]       # Left hip
            if sw["trunk_msl"]:
                self.trunk_anatomical_line.draw_mid_sagittal_line(frame, Rshoulder, Lshoulder, Rhip, Lhip)

            if sw["diaphragm"]:
                self.trunk_anatomical_line.draw_diaphragm_line(frame, pose_landmarks, frame.shape)
            if sw["iliac_crest"]:
                self.trunk_anatomical_line.draw_iliac_crest_line(frame, pose_landmarks, frame.shape)
            if sw["asis"]:
                self.trunk_anatomical_line.draw_asis_line(frame, pose_landmarks, frame.shape)

        # --- Trunk positioning assessment ---
        h, w = frame.shape[:2]
        trunk_m = self.trunk_positioning_tracker.update(result, w, h)
        if sw["trunk_level"]:
            self.trunk_positioning_tracker.show_level(frame, trunk_m)
        if sw["trunk_rotation"]:
            self.trunk_positioning_tracker.show_rotation(frame, trunk_m)

        return frame

    def run(self):
        """Standalone OpenCV display loop (for testing without a GUI)."""
        while self.cap.isOpened():
            success, frame = self.cap.read()
            if not success:
                break

            frame = self.process_frame(frame)
            display_frame = resize_for_display(frame)
            self.switches.draw_status(frame)
            cv2.imshow("Pose Detection", display_frame)

            k = cv2.waitKey(5) & 0xFF
            if k == 27:                                # ESC
                break
            self.switches.handle_key(k)

        self.release()

    def release(self):
        self.cap.release()
        cv2.destroyAllWindows()


if __name__ == "__main__":
    video_loop = VideoLoop(video_source=0)
    video_loop.run()
    