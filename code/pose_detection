video_path = r"C:\Users\User\Downloads\6799871-uhd_2160_4096_25fps.mp4"  # Enter the video file path here
cap = cv2.VideoCapture(0)
frame_timestamp = 0


while cap.isOpened():
    success, frame = cap.read()
    if not success:
        break


    rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb_frame)
    result = detector.detect_for_video(mp_image, frame_timestamp)
    frame_timestamp += 33  # ~30fps
    fm_results = fm.process(rgb_frame)

    #draw landmarks -> head
    if fm_results.multi_face_landmarks:
        for face_landmarks in fm_results.multi_face_landmarks:
            draw_head_medial_sagittal_line(frame, face_landmarks.landmark, frame.shape)
            draw_interpupillary_line(frame, face_landmarks.landmark, frame.shape)

    # Draw landmarks -> trunk 
    if result.pose_landmarks:
        for pose_landmarks in result.pose_landmarks:
            proto = landmark_pb2.NormalizedLandmarkList()
            proto.landmark.extend([
                landmark_pb2.NormalizedLandmark(x=lm.x, y=lm.y, z=lm.z)
                for lm in pose_landmarks
            ])
        solutions.drawing_utils.draw_landmarks(
            frame,
            proto,
            solutions.pose.POSE_CONNECTIONS,
            landmark_drawing_spec=solutions.drawing_utils.DrawingSpec(
                color=(0, 255, 0), thickness=4, circle_radius=5
            ),
            connection_drawing_spec=solutions.drawing_utils.DrawingSpec(
                color=(255, 255, 255), thickness=4
            )
        )

    #draw mdeial sagital lilne
    if result.pose_landmarks:
        Rshoulder = result.pose_landmarks[0][11]  # Right shoulder
        Lshoulder = result.pose_landmarks[0][12]  # Left shoulder
        Rhip = result.pose_landmarks[0][23]       # Right hip
        Lhip = result.pose_landmarks[0][24]       # Left hip
        draw_mid_sagittal_line(frame, Rshoulder, Lshoulder, Rhip, Lhip)

    # Draw anatomical lines for trunck
    if result.pose_landmarks:
        draw_diaphragm_line(frame, result.pose_landmarks[0], frame.shape)
        draw_iliac_crest_line(frame, result.pose_landmarks[0], frame.shape)
        draw_asis_line(frame, result.pose_landmarks[0], frame.shape)
    
    display_frame = resize_for_display(frame)
    cv2.imshow("Pose Detection", display_frame)

