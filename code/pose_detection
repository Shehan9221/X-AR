class Switches:
    """Keyboard-controlled on/off flags. Number keys toggle each overlay."""

    def __init__(self):
        # (key, name, starts_on)
        self._items = [
            ("A", "trunk_skeleton", True),
            ("B", "trunk_msl",      True),
            ("C", "diaphragm",      True),
            ("D", "iliac_crest",    True),
            ("E", "asis",           True),
            ("F", "head_mesh",      False),
            ("G", "head_msl",       True),
            ("H", "ipl",            True),
            ("I", "head_tilt",      True),
            ("J", "head_rotation",  True),
            ("K", "trunk_level",    True),
            ("L", "trunk_rotation", True),
        ]
        self.flags = {name: on for _, name, on in self._items}
        self.keys = {ord(key): name for key, name, _ in self._items}

    def __getitem__(self, name):
        return self.flags[name]

    def any_on(self, *names):
        return any(self.flags[n] for n in names)

    def handle_key(self, k):
        if k in self.keys:
            name = self.keys[k]
            self.flags[name] = not self.flags[name]

    def draw_status(self, frame):
        for i, (key, name, _) in enumerate(self._items):
            on = self.flags[name]
            color = (0, 255, 0) if on else (0, 0, 255)
            cv2.putText(frame, f"[{key}] {name}: {'ON' if on else 'OFF'}",
                        (10, frame.shape[0] - 15 - 22 * i),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 1)
