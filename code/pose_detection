class HeadPoseAssessment:
    """Owns MediaPipe FaceMesh setup and runs face-landmark detection per frame."""

    # --- Landmark indices (MediaPipe Face Mesh, refine_landmarks=True) ---
    LEFT_IRIS_CENTER = 468    # subject's left eye (mirrored image = viewer's right)
    RIGHT_IRIS_CENTER = 473   # subject's right eye

    # Points that sit on the facial midline, top to bottom.
    # 10: forehead/hairline, 168: nasion, 4: nose tip, 164: philtrum, 0: upper lip center, 17: lower lip/mentolabial fold, 152: chin (menton)
    MIDLINE_LANDMARKS = [10, 168, 4, 164, 0, 17, 152]

    def __init__(self, static_image_mode=False, refine_landmarks=True, max_num_faces=1):
        self.mp_face_mesh = mp.solutions.face_mesh
        self.fm = self.mp_face_mesh.FaceMesh(
            static_image_mode=static_image_mode,
            refine_landmarks=refine_landmarks,
            max_num_faces=max_num_faces
        )

    def detect(self, rgb_frame):
        """Runs FaceMesh on an RGB frame. Returns the raw mediapipe results object."""
        return self.fm.process(rgb_frame)

    def get_face_landmarks_list(self, rgb_frame):
        """Convenience: returns a list of face_landmarks (one per detected face), or [] if none found."""
        results = self.detect(rgb_frame)
        if results.multi_face_landmarks:
            return [face_landmarks.landmark for face_landmarks in results.multi_face_landmarks]
        return []


class HeadAnatomicalLine:
    """Computes and draws anatomical reference lines on the head/face."""

    @staticmethod
    def _to_px(landmark, w, h):
        return np.array([landmark.x * w, landmark.y * h])

    def compute_interpupillary_line(self, face_landmarks, image_width, image_height):
        """
        face_landmarks: the .landmark list from a MediaPipe FaceMesh result
        Returns dict with pupil points, midpoint, length, and tilt angle
        (angle_deg == 0 means perfectly horizontal / no head roll).
        """
        p_left = self._to_px(face_landmarks[HeadPoseAssessment.LEFT_IRIS_CENTER], image_width, image_height)
        p_right = self._to_px(face_landmarks[HeadPoseAssessment.RIGHT_IRIS_CENTER], image_width, image_height)

        delta = p_right - p_left
        angle_deg = np.degrees(np.arctan2(delta[1], delta[0]))  # tilt from horizontal

        return {
            "left_pupil": p_left,
            "right_pupil": p_right,
            "midpoint": (p_left + p_right) / 2,
            "length": float(np.linalg.norm(delta)),
            "angle_deg": float(angle_deg),   # + = right pupil lower, - = right pupil higher
        }

    def compute_head_medial_sagittal_line(self, face_landmarks, image_width, image_height,
                                           midline_indices=None):
        """
        Fits a line through several midline landmarks (PCA / total-least-squares)
        instead of just connecting two points, which makes it far less sensitive
        to a single noisy landmark.

        Returns dict with the fitted point set's centroid, unit direction vector,
        and tilt_from_vertical_deg (0 == perfectly vertical / no rotation).
        """
        if midline_indices is None:
            midline_indices = HeadPoseAssessment.MIDLINE_LANDMARKS

        pts = np.array([self._to_px(face_landmarks[i], image_width, image_height)
                         for i in midline_indices])

        centroid = pts.mean(axis=0)
        centered = pts - centroid

        # Principal axis of the midline points = best-fit line direction
        _, _, vh = np.linalg.svd(centered)
        direction = vh[0]
        if direction[1] < 0:          # force direction to point "downward" (+y)
            direction = -direction

        angle_from_vertical = np.degrees(np.arctan2(direction[0], direction[1]))

        return {
            "points": pts,
            "centroid": centroid,
            "direction": direction,          # unit vector, points top->chin
            "tilt_from_vertical_deg": float(angle_from_vertical),
            "top_point": pts[0],
            "bottom_point": pts[-1],
        }

    def draw_head_medial_sagittal_line(self, frame, face_landmarks, frame_shape, msl=None):
        h, w = frame_shape[:2]
        if msl is None:
            msl = self.compute_head_medial_sagittal_line(face_landmarks, w, h)

        c, d = msl["centroid"], msl["direction"]
        # span the fitted line over the extent of the midline points
        t_top = np.dot(msl["top_point"] - c, d)
        t_bot = np.dot(msl["bottom_point"] - c, d)
        top_point = tuple((c + t_top * d).astype(int))
        bottom_point = tuple((c + t_bot * d).astype(int))

        thickness, font_scale = get_scaled_line_params(frame_shape)
        cv2.line(frame, top_point, bottom_point, (0, 0, 255), thickness)
        cv2.putText(frame, "msl", (bottom_point[0] + 5, bottom_point[1] + 5),
                    cv2.FONT_HERSHEY_SIMPLEX, font_scale, (0, 0, 255), max(1, thickness))
        return msl

    def draw_interpupillary_line(self, frame, face_landmarks, frame_shape):
        h, w = frame_shape[:2]
        ip_line = self.compute_interpupillary_line(face_landmarks, w, h)
        left_pupil = tuple(ip_line["left_pupil"].astype(int))
        right_pupil = tuple(ip_line["right_pupil"].astype(int))

        thickness, font_scale = get_scaled_line_params(frame_shape)

        cv2.line(frame, left_pupil, right_pupil, (0, 255, 255), thickness)
        cv2.putText(frame, "ipl", (right_pupil[0] + 5, right_pupil[1] + 5),
                    cv2.FONT_HERSHEY_SIMPLEX, font_scale, (0, 255, 255), max(1, thickness))
        return ip_line

class HeadPossitioningTracker:
    """Computes head positioning metrics based on detected landmarks."""
    ROTATION_POINTS = {            # (subject's RIGHT, subject's LEFT)
        "iris":         (468, 473),
        "outer_corner": (33, 263),
        "inner_corner": (133, 362),}
        
    HEAD_ROTATION_THRESHOLDS_PCT = {"pass": 5.0, "borderline": 10.0}

    #assess head tilt based on medial sagittal line of head
    
    def assess_head_tilt(self, sagittal_result, thresholds=None, mirrored=False):
        """
        sagittal_result: dict from compute_head_medial_sagittal_line()
        mirrored: True if your feed is a selfie-style mirrored preview — this
                flips which raw image side maps to the patient's anatomical
                left/right. Verify empirically (see note below) rather than
                assuming.

        Returns: status ('pass'/'borderline'/'fail'), side ('left'/'right'/'none'),
                angle_deg (signed), abs_angle_deg
        """
        HEAD_TILT_THRESHOLDS_DEG = {
        "pass": 3.0,       # |angle| <= 3°  -> no clinically relevant tilt
        "borderline": 6.0, # 3° < |angle| <= 6° -> borderline, flag for review
        # anything beyond "borderline" -> fail
        }

        if thresholds is None:
            thresholds = HEAD_TILT_THRESHOLDS_DEG

        angle_deg = sagittal_result["tilt_from_vertical_deg"]
        abs_angle = abs(angle_deg)

        if abs_angle <= thresholds["pass"]:
            status, side = "pass", "none"
        else:
            status = "borderline" if abs_angle <= thresholds["borderline"] else "fail"

            # direction points top_point -> bottom_point (forced +y).
            # angle_deg > 0 means the line leans toward +x as it descends,
            # i.e. the bottom (chin) sits right of the top in image space.
            tilts_toward_image_right = angle_deg > 0
            if mirrored:
                side = "left" if tilts_toward_image_right else "right"
            else:
                side = "right" if tilts_toward_image_right else "left"

        return {
            "status": status,
            "side": side,
            "angle_deg": angle_deg,
            "abs_angle_deg": abs_angle,
        }
        """Assesses head tilt based on msl of head."""

    def show_head_tilt_assessment(self, frame, face_landmark, msl=None,
                                  thresholds=None, mirrored=False):
        h, w = frame.shape[:2]
        if msl is None:
            msl = HeadAnatomicalLine().compute_head_medial_sagittal_line(face_landmark, w, h)
        assessment = self.assess_head_tilt(msl, thresholds, mirrored)

        colors = {"pass": (0, 200, 0), "borderline": (0, 200, 255), "fail": (0, 0, 255)}
        color = colors[assessment["status"]]

        text = (f"Head Tilt: {assessment['status']} "
                f"({assessment['side']}, {assessment['angle_deg']:.1f}°)")
        cv2.putText(frame, text, (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.8, color, 2)
        return assessment

    @staticmethod
    def _dist_to_msl(p, msl):
        """Perpendicular distance and foot point of p on the fitted MSL."""
        c, d = msl["centroid"], msl["direction"]      # d is a unit vector
        foot = c + np.dot(p - c, d) * d
        return float(np.linalg.norm(p - foot)), foot

    def assess_head_rotation(self, face_landmarks, msl, w, h, mode="iris",
                             thresholds=None, mirrored=False):
        """
        Rotation about the vertical axis using the SAME fitted MSL that is drawn.
        asymmetry_pct > 0 => subject's right eye farther from MSL
                          => head turned toward subject's left.
        """
        thresholds = thresholds or self.HEAD_ROTATION_THRESHOLDS_PCT
        r_idx, l_idx = self.ROTATION_POINTS[mode]
        to_px = HeadAnatomicalLine._to_px
        r_pt = to_px(face_landmarks[r_idx], w, h)
        l_pt = to_px(face_landmarks[l_idx], w, h)

        d_r, foot_r = self._dist_to_msl(r_pt, msl)
        d_l, foot_l = self._dist_to_msl(l_pt, msl)

        total = d_r + d_l
        asym = (d_r - d_l) / total * 100.0 if total > 0 else 0.0
        abs_asym = abs(asym)

        if abs_asym <= thresholds["pass"]:
            status, side = "pass", "none"
        else:
            status = "borderline" if abs_asym <= thresholds["borderline"] else "fail"
            side = "left" if asym > 0 else "right"
            if mirrored:
                side = "right" if side == "left" else "left"

        return {"status": status, "side": side,
                "asymmetry_pct": asym, "abs_asymmetry_pct": abs_asym,
                "dist_right": d_r, "dist_left": d_l,
                "eye_pts": (r_pt, l_pt), "feet": (foot_r, foot_l)}

    def show_head_rotation(self, frame, face_landmark, msl, mode="iris",
                           thresholds=None, mirrored=False):
        h, w = frame.shape[:2]
        res = self.assess_head_rotation(face_landmark, msl, w, h, mode, thresholds, mirrored)

        colors = {"pass": (0, 200, 0), "borderline": (0, 200, 255), "fail": (0, 0, 255)}
        color = colors[res["status"]]
        thickness, font_scale = get_scaled_line_params(frame.shape)

        for pt, foot, dist, label in zip(res["eye_pts"], res["feet"],
                                         (res["dist_right"], res["dist_left"]), ("R", "L")):
            p, f = tuple(pt.astype(int)), tuple(foot.astype(int))
            cv2.line(frame, p, f, color, thickness)
            cv2.circle(frame, p, 3, color, -1)
            cv2.circle(frame, f, 3, (255, 255, 0), -1)
            mid = ((pt + foot) / 2).astype(int)
            cv2.putText(frame, f"{label}:{dist:.0f}px", (mid[0] - 20, mid[1] - 8),
                        cv2.FONT_HERSHEY_SIMPLEX, font_scale * 0.9, color, 1)

        text = f"Head Rotation: {res['status']} ({res['side']}, {res['asymmetry_pct']:+.1f}%)"
        cv2.putText(frame, text, (10, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.8, color, 2)
        return res
    #head roatation assesment around y axis

        

